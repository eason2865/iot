# HTTP
PORT=8080
LISTEN_ADDR=:8080

# iot-core gRPC endpoint
IOT_CORE_ENDPOINTS=127.0.0.1:9001
IOT_CORE_LISTEN_ON=:9001

# PostgreSQL
POSTGRES_DSN=postgres://iot:iot123@localhost:5432/iot?sslmode=disable

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=iot.telemetry
KAFKA_COMMAND_TOPIC=iot.command
KAFKA_DLQ_TOPIC=iot.dlq

# EMQX / MQTT
EMQX_URL=tcp://127.0.0.1:1883
EMQX_TOPIC_FILTER=tenant/+/device/+/telemetry
EMQX_TELEMETRY_INGESTOR_CLIENT_ID=iot-telemetry-ingestor
EMQX_DEVICE_WORKER_CLIENT_ID=iot-device-worker

# Auth secrets (required in k8s; local bare runs fall back to dev defaults)
MANAGEMENT_API_TOKEN=local-development-token
EMQX_INTERNAL_PASSWORD=local-mqtt-service-password
IOT_CORE_MQTT_AUTH_TOKEN=local-mqtt-auth-token

# TDengine
TDENGINE_DSN='root:taosdata@http(127.0.0.1:6041)/iot'
TDENGINE_TABLE=telemetry_v2

# iot-core gRPC mTLS (leave all unset for plaintext local runs; set all three
# on both iot-core and management-api to enable mutual TLS)
#IOT_CORE_TLS_CERT=/etc/iot/grpc-tls/server.crt   # client.crt on management-api
#IOT_CORE_TLS_KEY=/etc/iot/grpc-tls/server.key     # client.key on management-api
#IOT_CORE_TLS_CA=/etc/iot/grpc-tls/ca.crt
#IOT_CORE_TLS_SERVER_NAME=iot-core                 # client only

# Demo simulator
DEMO_MANAGEMENT_API_URL=http://127.0.0.1:8080
DEMO_MQTT_URL=tcp://127.0.0.1:1883
DEMO_TENANT_COUNT=5
DEMO_DEVICES_PER_TENANT=10
DEMO_TENANT_PREFIX=demo
DEMO_PRODUCT_ID=product-demo
DEMO_TICK_INTERVAL=250ms
DEMO_TELEMETRY_BURST_MIN=1
DEMO_TELEMETRY_BURST_MAX=5
DEMO_COMMAND_BURST_MIN=1
DEMO_COMMAND_BURST_MAX=3
