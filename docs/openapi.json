{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Command": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "status": {
            "enum": [
              "created",
              "published",
              "sent",
              "acked",
              "failed",
              "timeout"
            ],
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CommandAckInput": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "deviceId"
        ],
        "type": "object"
      },
      "CommandInput": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "deviceId",
          "payload"
        ],
        "type": "object"
      },
      "Device": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "DeviceInput": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "secret": {
            "description": "device MQTT password; stored as bcrypt hash",
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "deviceId",
          "productId",
          "secret"
        ],
        "type": "object"
      },
      "DeviceStatus": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "lastSeenAt": {
            "format": "date-time",
            "type": "string"
          },
          "online": {
            "type": "boolean"
          },
          "tenantId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TelemetryEnvelope": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "msgId": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "tenantId": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "msgId",
          "tenantId",
          "deviceId",
          "ts",
          "type",
          "version",
          "payload"
        ],
        "type": "object"
      },
      "TelemetryRecord": {
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "msgId": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "receivedAt": {
            "format": "date-time",
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "ts": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Tenant": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "TenantInput": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "token",
        "description": "Service token from MANAGEMENT_API_TOKEN, sent as Authorization: Bearer \u003ctoken\u003e",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "MQTT IoT Platform API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/commands": {
      "get": {
        "description": "List commands for one tenant; tenantId is required.",
        "parameters": [
          {
            "in": "query",
            "name": "tenantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "items per page (max 100)",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "opaque keyset cursor from a previous response's nextCursor",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/Command"
                      },
                      "type": "array"
                    },
                    "nextCursor": {
                      "description": "pass as cursor for the next page; empty when no more pages",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "list commands (keyset-paginated)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "missing or invalid bearer token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Command"
                }
              }
            },
            "description": "command created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "missing or invalid bearer token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
